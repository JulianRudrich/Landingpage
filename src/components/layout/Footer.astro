---
// Grundversion – gehört WP-04 (Header & Footer). WP-04 ergänzt Claim, Kontakt, Navigation und Profile (FA-16).
import { site } from '@/config/site';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer>
  <nav aria-label={t.navigation.footer.legalHeading}>
    <ul>
      <li>
        <a href="/impressum/">{t.navigation.footer.impressum}</a>
      </li>
      <li>
        <a href="/datenschutz/">{t.navigation.footer.datenschutz}</a>
      </li>
    </ul>
  </nav>
  <p>{`© ${year} ${site.name}. ${t.navigation.footer.copyright}`}</p>
</footer>
