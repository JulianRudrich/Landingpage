---
// Gehört WP-09 (SEO & Meta). `Props` ist der Vertrag für alle Seiten: BaseLayout (WP-03) übernimmt ihn
// unverändert. Änderungen an den Props nur per Spec-Änderung (SPECS.md §16).
// Grundversion: WP-09 ergänzt Canonical-URL, Open Graph, Twitter-Card, Apple-Touch-Icon, theme-color und
// JSON-LD (nur auf der Startseite). Regeln: docs/pakete/WP-09-seo-meta.md
import type { ImageMetadata } from 'astro';

import { site } from '@/config/site';
import { fill } from '@/i18n';

export interface Props {
  /** Seitentitel OHNE Markennamen; darf {name} und {region} enthalten */
  title: string;
  /** Meta-Description, höchstens 155 Zeichen; darf {name} und {region} enthalten */
  description: string;
  /** true = Seite nicht indexieren (/danke/, 404, /styleguide/) */
  noindex?: boolean;
  /** Vorschaubild für Social Media; ohne Angabe wird public/og-image.png verwendet */
  image?: ImageMetadata;
  /** Alt-Text zu `image` */
  imageAlt?: string;
  /** 'article' für Projektdetailseiten, sonst 'website' */
  type?: 'website' | 'article';
}

const { title, description, noindex = false } = Astro.props;

/** Titel-Muster "{title} | {name}"; der Markenname entfällt, wenn der Titel sonst länger als 60 Zeichen würde. */
const pageTitle = fill(title);
const withBrand = `${pageTitle} | ${site.name}`;
const fullTitle = withBrand.length <= 60 ? withBrand : pageTitle;
---

<title>{fullTitle}</title>
<meta name="description" content={fill(description)} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/site.webmanifest" />
