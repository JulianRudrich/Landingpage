---
// Gehört WP-03 (Design-System). Props sind ein Vertrag mit allen Paketen: Änderungen nur per Spec-Änderung (SPECS.md §16).
// Grundversion: WP-03 gestaltet die Varianten nach Tonys Entwurf (Tokens primary, on-primary, …).
// `aria-*`- und `data-*`-Attribute reicht Button an <a> bzw. <button> durch. Andere Attribute (id, onclick …)
// gibt es nicht: `npm run check` bzw. `npm run lint` melden sie.
import { useTranslations } from '@/i18n';

import Icon from './Icon.astro';
import type { IconName } from './icons';

/** Link-Variante: mit `href`, optional `external` (neuer Tab + Screenreader-Hinweis) */
interface LinkProps {
  href: string;
  external?: boolean;
  type?: never;
}

/** Button-Variante: ohne `href`, `type` = 'submit' in Formularen */
interface ActionProps {
  href?: never;
  external?: never;
  type?: 'button' | 'submit';
}

type Props = (LinkProps | ActionProps) & {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Optionales Icon hinter dem Text */
  icon?: IconName;
  class?: string;
  /** Wird durchgereicht, z. B. `aria-describedby` oder `data-track` */
  [attribute: `aria-${string}` | `data-${string}`]: string | boolean | undefined;
};

const {
  href,
  external = false,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  class: className,
  ...passthrough
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
const classes = ['inline-flex items-center gap-2', className];
// Die Varianten stehen als data-* am Element, damit WP-03 sie mit `data-[variant=primary]:…` gestalten kann
const attributes = { ...passthrough, 'data-variant': variant, 'data-size': size };
---

{href ? (
  <a
    {...attributes}
    href={href}
    class:list={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <slot />
    {icon && <Icon name={icon} size={18} />}
    {external && <span class="sr-only">{t.common.externalLinkHint}</span>}
  </a>
) : (
  <button {...attributes} type={type} class:list={classes}>
    <slot />
    {icon && <Icon name={icon} size={18} />}
  </button>
)}
