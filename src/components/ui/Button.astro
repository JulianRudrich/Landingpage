---
// Gehört WP-03 (Design-System). Props sind ein Vertrag mit allen Paketen: Änderungen nur per Spec-Änderung (SPECS.md §16).
// Grundversion: WP-03 gestaltet die Varianten nach Tonys Entwurf (Tokens primary, on-primary, …).
// Button reicht KEINE weiteren HTML-Attribute durch (aria-*, data-*, id). Wer so etwas braucht (z. B. der
// Burger-Button in WP-04), baut ein eigenes <button> mit Token-Klassen.
import { useTranslations } from '@/i18n';

import Icon from './Icon.astro';
import type { IconName } from './icons';

/** Link-Variante: mit `href`, optional `external` (neuer Tab + Screenreader-Hinweis) */
interface LinkProps {
  href: string;
  external?: boolean;
  type?: never;
}

/** Button-Variante: ohne `href`, `type` = 'submit' in Formularen */
interface ActionProps {
  href?: never;
  external?: never;
  type?: 'button' | 'submit';
}

type Props = (LinkProps | ActionProps) & {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Optionales Icon hinter dem Text */
  icon?: IconName;
  class?: string;
};

const {
  href,
  external = false,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  class: className,
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
const classes = ['inline-flex items-center gap-2', className];
---

{href ? (
  <a
    href={href}
    class:list={classes}
    data-variant={variant}
    data-size={size}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <slot />
    {icon && <Icon name={icon} size={18} />}
    {external && <span class="sr-only">{t.common.externalLinkHint}</span>}
  </a>
) : (
  <button type={type} class:list={classes} data-variant={variant} data-size={size}>
    <slot />
    {icon && <Icon name={icon} size={18} />}
  </button>
)}
