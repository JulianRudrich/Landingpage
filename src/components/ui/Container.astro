---
// Gehört WP-03 (Design-System). Props sind ein Vertrag mit allen Paketen: Änderungen nur per Spec-Änderung (SPECS.md §16).
// Grundversion: WP-03 gestaltet sie nach Tonys Entwurf. Max. Breite kommt aus dem Token --container-site.

interface Props {
  /** HTML-Element, Standard: div */
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['mx-auto w-full max-w-site px-4', className]}>
  <slot />
</Tag>
